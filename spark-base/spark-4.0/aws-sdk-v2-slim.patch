     <!--
       the AWS module pulls in jackson; its transitive dependencies can create
       intra-jackson-module version problems.
+
+      SPARK-SLIM-AWS: the full "software.amazon.awssdk:bundle" shaded uber-jar
+      packages every AWS SDK v2 service client (hundreds of MB) even though
+      hadoop-aws only ever calls into the S3, STS and KMS clients (plus the
+      apache/netty HTTP client implementations). Excluding the bundle and
+      declaring only the modules that are actually used keeps the same
+      functionality while dramatically slimming the resulting distribution.
       -->
     <dependency>
       <groupId>org.apache.hadoop</groupId>
